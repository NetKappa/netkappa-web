---
import '../styles/global.css';
---

<html lang="el" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NetKappa | AI Solutions</title>
  </head>
  <body class="bg-slate-950 text-slate-300 font-sans antialiased selection:bg-purple-500 selection:text-white flex flex-col min-h-screen">
    
    <!-- Header Section -->
    <header class="fixed w-full top-0 z-50 bg-slate-950/80 backdrop-blur-md border-b border-slate-800">
      <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
       <a href="\netkappa-r-b.png" class="flex items-center">
  <img src="\netkappa-r-b.png" alt="NetKappa" class="h-10 w-auto" />
</a>
        
        <nav class="hidden md:flex gap-8 text-sm font-medium">
          <a href="#features" class="hover:text-white transition-colors">Χαρακτηριστικά</a>
          <a href="#solutions" class="hover:text-white transition-colors">Λύσεις</a>
          <a href="#pricing" class="hover:text-white transition-colors">Τιμολόγηση</a>
        </nav>

        <a href="#contact" class="hidden md:inline-flex items-center justify-center px-6 py-2.5 text-sm font-semibold text-white bg-slate-800 border border-slate-700 rounded-full hover:bg-slate-700 hover:border-slate-600 transition-all">
          Επικοινωνία
        </a>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow pt-32">
      <section class="relative max-w-7xl mx-auto px-6 py-24 text-center flex flex-col items-center">
        <div class="mb-8 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-sm font-medium">
          <span class="flex h-2 w-2 rounded-full bg-purple-500"></span>
          Η νέα εποχή είναι εδώ
        </div>
        
        <h1 class="text-5xl md:text-7xl font-extrabold text-white tracking-tight leading-tight mb-8 max-w-4xl">
          Χτίσε το μέλλον με <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-blue-500 to-purple-600">
            Έξυπνες Λύσεις
          </span>
        </h1>
        
        <p class="text-lg md:text-xl text-slate-400 max-w-2xl mb-12 leading-relaxed">
          Μια ολοκληρωμένη πλατφόρμα σχεδιασμένη για να απογειώσει την παραγωγικότητά σου. Γρήγορη, ασφαλής και βασισμένη σε τεχνολογίες αιχμής.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 w-full justify-center">
          <a href="#" class="px-8 py-4 rounded-full bg-white text-slate-950 font-bold hover:bg-slate-200 transition-colors">
            Ξεκινήστε δωρεάν
          </a>
          <a href="#" class="px-8 py-4 rounded-full bg-transparent text-white font-bold border border-slate-700 hover:bg-slate-800 transition-colors">
            Δείτε το Demo
          </a>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-900 py-12">
      <div class="max-w-7xl mx-auto px-6 text-center text-slate-500 text-sm">
        <p>&copy; 2026 NetKappa. Με επιφύλαξη παντός δικαιώματος.</p>
      </div>
    </footer>

  </body>
</html>
